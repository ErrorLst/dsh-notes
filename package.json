{
  "name": "@dsh-external/dsh-notes",
  "description": "全局浮动小记窗口（待办 / 随记两个页签）：自由拖动、自由缩放、可折叠；DSH 主题令牌适配",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "main": "lib/index.mjs",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.2-rc.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown --config ./tsdown.config.ts",
    "test": "node --test test/client-css.test.mjs test/client-current-session.test.mjs test/client-window.test.mjs"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "tsdown": "0.22.2"
  },
  "license": "MIT"
}
